# F1 Race Predictor 2026 - optional environment overrides.
# Copy to `.env` and adjust. Every value here has a working default, so the
# project runs without this file at all; no API keys are required.

# Base URL for the Ergast-compatible results API.
# Ergast shut down after 2024; the default is the Jolpica-F1 mirror.
# Override to point at a self-hosted mirror or a local proxy.
F1_ERGAST_BASE_URL=https://api.jolpi.ca/ergast/f1
